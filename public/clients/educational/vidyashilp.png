<script>
	function togglenews() {
		const newsubmenu = document.getElementById('newsubmenu');
		newsubmenu.classList.toggle('display_block')
	}

	window.addEventListener('scroll', function() {
		var logoContainer = document.getElementById('logo-container');
		var navItems = document.querySelectorAll('.main-menu ul li span a');
		var defaultblack = document.querySelectorAll('.default-black');

		if (window.scrollY > 1) {
			logoContainer.innerHTML = '<a href="index.php"><img src="img_landing/footer_logo.png" class="site-logo" alt=""></a>';
			navItems.forEach(function(item) {
				item.style.color = 'white'

				if (item.style.color == 'white') {
					defaultblack.forEach(function(blackcol) {
						blackcol.style.color = 'black';
						blackcol.style.backgroundColor = 'white';
					})
				}
			});
		} else {
			logoContainer.innerHTML = '<a href="index.php"><img src="img_landing/logo.png" class="site-logo" alt=""></a>';
			navItems.forEach(function(item) {
				item.style.color = 'black'; // Reset to default color
			});
		}
	});


	var currentPage = window.location.pathname;

	var navLinks = document.querySelectorAll('.matchurl a');
	navLinks.forEach(function(navLink) {
		// Use the includes() method to handle cases where the URL may contain additional parameters
		if (currentPage.includes(navLink.getAttribute('href'))) {
			navLink.classList.add('link-black');
		}
	});
</script>		<!-- header -->

