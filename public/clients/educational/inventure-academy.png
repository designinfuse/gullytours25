	console.log('match the today date1');
	
} else if((check <= to2 && check >= from2)) {
	jQuery('#header-top-right-menu #menu-item-16289 a').css("display", "inline-block");
	jQuery('#header-top-right-menu #menu-item-1133.menu-item a').attr("style","border-right:1px solid #fff");
	jQuery('.footer-top#covid-protocal').css("display", "flex");
    console.log('match the today date2');
	
} else if((check <= to3 && check >= from3)) {
	jQuery('#header-top-right-menu #menu-item-16289 a').css("display", "inline-block");
	jQuery('#header-top-right-menu #menu-item-1133.menu-item a').attr("style","border-right:1px solid #fff");
	jQuery('.footer-top#covid-protocal').css("display", "flex");
	console.log('match the today date3');
	
} else if((check <= to4 && check >= from4)) {
	jQuery('#header-top-right-menu #menu-item-16289 a').css("display", "inline-block");
	jQuery('#header-top-right-menu #menu-item-1133.menu-item a').attr("style","border-right:1px solid #fff");
	jQuery('.footer-top#covid-protocal').css("display", "flex");
	console.log('match the today date4');
	
} else if((check <= to5 && check >= from5)) {
	jQuery('#header-top-right-menu #menu-item-16289 a').css("display", "inline-block");
	jQuery('#header-top-right-menu #menu-item-1133.menu-item a').attr("style","border-right:1px solid #fff");
