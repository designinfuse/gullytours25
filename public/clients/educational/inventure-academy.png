	// validation char only
	jQuery( document ).ready(function() {
		jQuery(".alphaonly").on("input", function(){
		  var regexp = /[^a-zA-Z ]/g;
		  if(jQuery(this).val().match(regexp)){
			jQuery(this).val( jQuery(this).val().replace(regexp,'') );
		  }
		});
	});
	
