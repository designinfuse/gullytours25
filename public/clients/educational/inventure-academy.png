var month = d.getMonth()+1;
var day = d.getDate();

var Today = d.getFullYear() + '/' +
    ((''+month).length<2 ? '0' : '') + month + '/' +
    ((''+day).length<2 ? '0' : '') + day;

// mm/dd/yy
var dateFrom1 = "06/09/2023";
var dateTo1 = "06/20/2023";
	
var dateFrom2 = "08/12/2023";
